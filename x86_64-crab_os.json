{
  "llvm-target": "x86_64-unknown-windows",
  "data-layout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "arch": "x86_64",
  "cpu": "x86-64",
  "target-endian": "little",
  "target-pointer-width": 64,
  "target-c-int-width": 32,
  "max-atomic-width": 64,
  "os": "uefi",
  "executables": true,
  "exe-suffix": ".efi",
  "binary-format": "coff",
  "archive-format": "coff",
  "is-like-windows": true,
  "is-like-msvc": true,
  "abi-return-struct-as-int": true,
  "debuginfo-kind": "pdb",
  "emit-debug-gdb-scripts": false,
  "split-debuginfo": "packed",
  "supported-split-debuginfo": ["packed"],
  "linker": "rust-lld",
  "linker-flavor": "msvc-lld",
  "linker-is-gnu": false,
  "lld-flavor": "link",
  "pre-link-args": {
    "msvc-lld": ["/NOLOGO", "/entry:efi_main", "/subsystem:efi_application"]
  },
  "entry-name": "efi_main",
  "entry-abi": "win64",
  "panic-strategy": "abort",
  "disable-redzone": true,
  "stack-probes": { "kind": "call" },
  "features": "-mmx,-sse,+soft-float",
  "rustc-abi": "softfloat"
}
